# Database
MONGODB_URI=mongodb://localhost:27017/sales_crm

# Auth — use at least 32 random characters (openssl rand -base64 32)
JWT_SECRET=replace-with-a-long-random-secret

# Public app URL (used for links and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: country code added to 10-digit phone numbers on import
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91

# Super admin — sign in with these; the account is created automatically
SUPER_ADMIN_NAME=Owner
SUPER_ADMIN_USERNAME=owner
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me-now
