# Database
MONGODB_URI=mongodb://localhost:27017/sales_crm

# Auth — use at least 32 random characters (openssl rand -base64 32)
JWT_SECRET=replace-with-a-long-random-secret

# Public app URL (used for links and metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: country code added to 10-digit phone numbers on import
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91

# Seed script only — run `npm run seed` after setting these
SEED_ADMIN_NAME=Owner
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=change-me-now
